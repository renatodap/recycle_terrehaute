{
  "expo": {
    "name": "SnapCycle",
    "slug": "recycle-terre-haute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "snapcycle",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapcycle.app",
      "buildNumber": "11",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapCycle needs camera access to scan items and identify if they're recyclable",
        "NSPhotoLibraryUsageDescription": "SnapCycle needs photo library access to analyze images of items for recycling guidance",
        "NSLocationWhenInUseUsageDescription": "SnapCycle needs your location to find the nearest recycling centers and provide collection reminders",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SnapCycle uses your location to send reminders when you're near recycling centers"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.snapcycle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ec6e56f2-603f-4a14-ae8b-01ab10263f72"
      }
    },
    "owner": "renatodap"
  }
}
